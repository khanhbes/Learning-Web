# Local website and grading. Copy to .env; keep your API key in .env only.
BYTEPATH_MODE=local
PORT=3001
BYTEPATH_DB=.data/bytepath.sqlite
BYTEPATH_RUNNER=wasm
# Gemini is only a tutor. Grading runs locally with verified tests.
BYTEPATH_AI=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Set to 1 only with a Free Tier project with billing disabled.
GEMINI_FREE_TIER_CONFIRMED=0
GEMINI_DAILY_LIMIT=20
