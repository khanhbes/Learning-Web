{
  "name": "bytepath",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "catalog": "node scripts/catalog.mjs",
    "runner:build": "docker build -t bytepath-runner:1 runner",
    "runner:setup": "node scripts/setup-wasm.mjs",
    "verify:solutions": "node scripts/verify-solutions.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@chriskoch/cpp-wasm": "^1.0.2",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@fontsource/nunito": "^5.2.6",
    "@monaco-editor/react": "^4.7.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
