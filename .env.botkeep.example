# Optional cloud deployment. Default local setup is in .env.example.
BYTEPATH_MODE=cloud
BYTEPATH_PUBLIC_ORIGIN=https://your-bytepath-domain.example
BYTEPATH_PASSWORD=replace-with-your-own-long-password
BYTEPATH_DB=.data/bytepath.sqlite
BYTEPATH_RUNNER=wasm
BYTEPATH_AI=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=0
GEMINI_DAILY_LIMIT=20
